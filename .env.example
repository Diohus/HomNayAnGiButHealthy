# Sao chép thành .env và điền giá trị. KHÔNG commit file .env.

# --- PostgreSQL ---
POSTGRES_USER=homnayangi
POSTGRES_PASSWORD=doi-mat-khau-nay
POSTGRES_DB=homnayangi

# --- Bảo mật ---
# Chuỗi ngẫu nhiên dài: python -c "import secrets;print(secrets.token_urlsafe(48))"
JWT_SECRET=
# Khóa mã hóa dữ liệu sức khỏe (Fernet): python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())"
# MẤT KHÓA = MẤT DỮ LIỆU HỒ SƠ. Sao lưu riêng.
HEALTH_DATA_KEY=
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=7
CORS_ORIGINS=https://localhost
# Tên miền thật để Caddy tự cấp HTTPS (mặc định localhost = chứng chỉ nội bộ)
SITE_ADDRESS=localhost

# --- LLM (chỉ dùng để hiểu câu chat và viết cách chế biến; không sinh số liệu) ---
# Để trống LLM_API_KEY ⇒ chạy chế độ dự phòng (parser quy tắc + công thức mẫu).
LLM_PROVIDER=openai
LLM_MODEL=gpt-6-luna
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_TIMEOUT_S=15
LLM_MAX_RETRIES=2
# Provider ẩn: bật LLM_EXPERIMENTAL_PROVIDERS=true và LLM_PROVIDER=anthropic (cần cài extra [claude])
LLM_EXPERIMENTAL_PROVIDERS=false
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5

PLANNER_TOLERANCE=0.05
